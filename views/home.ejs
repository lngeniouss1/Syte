<%- include('partials/header', { title, activePage }) %>
<section class="home-intro page-shell">
  <h1>Всё для ваших покупок</h1>
</section>

<section class="feature-slider page-shell" aria-label="Предложения магазина">
  <div class="slides">
    <article class="slide is-current" data-slide="0" aria-hidden="false">
      <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=2000&q=85" alt="Интерьер магазина с товарами на полках" fetchpriority="high">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Новинки</h2></div>
    </article>
    <article class="slide" data-slide="1" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=2000&q=85" alt="Витрина магазина с товарами" loading="lazy">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Популярное</h2></div>
    </article>
    <article class="slide" data-slide="2" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1555529669-e69e7aa0ba9a?auto=format&fit=crop&w=2000&q=85" alt="Покупки и товары из магазина" loading="lazy">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Специальные предложения</h2></div>
    </article>
  </div>
  <div class="slider-controls" aria-label="Управление слайдером">
    <div class="slider-arrows"><button type="button" data-previous aria-label="Предыдущий слайд">Назад</button><button type="button" data-next aria-label="Следующий слайд">Вперёд</button></div>
  </div>
</section>
<%- include('partials/footer') %>