<%- include('partials/header', { title, activePage }) %>
<section class="home-intro page-shell">
  <h1>Путешествуй и открывай новое</h1>
</section>

<section class="feature-slider page-shell" aria-label="Идеи для путешествий">
  <div class="slides">
    <article class="slide is-current" data-slide="0" aria-hidden="false">
      <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=85" alt="Снежные вершины гор на рассвете" fetchpriority="high">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Горы</h2></div>
    </article>
    <article class="slide" data-slide="1" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?auto=format&fit=crop&w=2000&q=85" alt="Морские волны у песчаного побережья" loading="lazy">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Море</h2></div>
    </article>
    <article class="slide" data-slide="2" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=85" alt="Домик у озера среди гор и леса" loading="lazy">
      <div class="slide-shade"></div>
      <div class="slide-content"><h2>Отдых на природе</h2></div>
    </article>
  </div>
  <div class="slider-controls" aria-label="Управление слайдером">
    <div class="slider-dots">
      <button class="slider-dot is-current" type="button" aria-label="Слайд 1" aria-pressed="true" data-go-to="0"></button>
      <button class="slider-dot" type="button" aria-label="Слайд 2" aria-pressed="false" data-go-to="1"></button>
      <button class="slider-dot" type="button" aria-label="Слайд 3" aria-pressed="false" data-go-to="2"></button>
    </div>
    <div class="slider-arrows"><button type="button" data-previous aria-label="Предыдущий слайд">Назад</button><button type="button" data-next aria-label="Следующий слайд">Вперёд</button></div>
  </div>
</section>
<%- include('partials/footer') %>